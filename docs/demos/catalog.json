{
  "schema_version": 1,
  "title": "GPUI Toolkit demos",
  "description": "Generated snapshots and live WebGPU demos for the GPUI Toolkit showcase applications.",
  "public_base_url": "https://gpui-toolkit.spinorama.org/",
  "apps": [
    {
      "id": "showcase",
      "title": "UI Kit Showcase",
      "description": "Buttons, forms, workflows, navigation, accessibility, and responsive GPUI components.",
      "route": "showcase/",
      "source_url": "https://github.com/pierreaubert/gpui-toolkit/tree/main/crates/gpui-showcase",
      "port": 8081,
      "manifest_command": [
        "cargo",
        "run",
        "-p",
        "gpui-showcase",
        "--bin",
        "gpui-showcase",
        "--",
        "--visual-manifest",
        "--json"
      ],
      "picture_theme": "dark"
    },
    {
      "id": "d3rs",
      "title": "d3rs Showcase",
      "description": "D3.js-inspired scales, shapes, geo, hierarchy, force, and Observable examples.",
      "route": "d3rs/",
      "source_url": "https://github.com/pierreaubert/gpui-toolkit/tree/main/crates/gpui-d3rs",
      "port": 8083,
      "manifest_command": [
        "cargo",
        "run",
        "-p",
        "gpui-d3rs",
        "--features",
        "vello-gpui",
        "--example",
        "d3rs-showcase",
        "--",
        "--visual-manifest",
        "--json"
      ],
      "picture_theme": "forest"
    },
    {
      "id": "mesh",
      "title": "Mesh Showcase",
      "description": "3D mesh fields on a Taylor-Green vortex: vortex cores, slices, contours, and isosurface shells.",
      "route": "mesh/",
      "source_url": "https://github.com/pierreaubert/gpui-toolkit/tree/main/crates/gpui-scene3d",
      "port": 8085,
      "manifest_command": [
        "cargo",
        "run",
        "-p",
        "gpui-scene3d",
        "--features",
        "gpui",
        "--example",
        "mesh-showcase",
        "--",
        "--visual-manifest",
        "--json"
      ],
      "picture_theme": "midnight"
    },
    {
      "id": "spinorama",
      "title": "Spinorama Showcase",
      "description": "Explore real speakers with CEA-2034 curves, polar directivity, contours, 3D surfaces, and sphere views.",
      "route": "spinorama/",
      "source_url": "https://github.com/pierreaubert/gpui-toolkit/tree/main/crates/gpui-spinorama",
      "port": 8084,
      "manifest_command": [
        "cargo",
        "run",
        "-p",
        "gpui-spinorama",
        "--bin",
        "spinorama-showcase",
        "--",
        "--visual-manifest",
        "--json"
      ],
      "picture_theme": "carbon-white"
    },
    {
      "id": "px",
      "title": "Chart Showcase",
      "description": "Plotly Express-style scatter, line, bar, heatmap, contour, isoline, and treemap charts.",
      "route": "px/",
      "source_url": "https://github.com/pierreaubert/gpui-toolkit/tree/main/crates/gpui-px",
      "port": 8082,
      "manifest_command": [
        "cargo",
        "run",
        "-p",
        "gpui-px",
        "--features",
        "vello",
        "--bin",
        "px-showcase",
        "--",
        "--visual-manifest",
        "--json"
      ],
      "picture_theme": "light"
    },
    {
      "id": "hello",
      "title": "Hello WebGPU",
      "description": "The minimal GPUI-on-WASM smoke demo.",
      "route": "hello/",
      "source_url": "https://github.com/pierreaubert/gpui-toolkit/tree/main/crates/gpui-hello-web",
      "static_image": "qa/visual/wasm/baselines/hello.png"
    }
  ],
  "featured": [
    "showcase-buttons-desktop",
    "showcase-form-controls-desktop",
    "showcase-workflow-desktop",
    "px-heatmap-desktop",
    "px-contour-desktop",
    "px-scatter-desktop",
    "d3rs-geo-desktop",
    "d3rs-d3-volcano-desktop",
    "spinorama-3d-surface-desktop",
    "spinorama-cea-2034-desktop",
    "mesh-vortices-desktop",
    "mesh-slice-desktop",
    "hello"
  ]
}
