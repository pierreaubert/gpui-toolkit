  "methodology": "ABBA twice; four processes per variant; one warmup and five samples per process/case. Hit cases perform 10000 requests on populated 128/4096-entry caches. High bits of a 64-bit LCG avoid low-bit repeating full-cache permutations; entry counts and width sums are validated outside the timed region. Cold cases: 10000 requests rotating 512 prebuilt strings through an 8-entry cache; 100 full preparations of a repeated Unicode paragraph. Compare medians of process medians. Shared host, no affinity/thermal/energy control.",
  "probe_source": "use gpui_pretext::{MeasureCache, TextMeasure, prepare_with_segments, EngineProfile, PrepareOptions};\nuse gpui_profiler::AllocProbe;\nuse std::{hint::black_box, time::Instant};\nstruct Width;\nimpl TextMeasure for Width {\n    fn measure_width(&self, text: &str) -> f64 { text.chars().count() as f64 * 8.0 }\n    fn cache_key(&self) -> u64 { 0x636c6f636b }\n    fn cache_key_is_stable(&self) -> bool { true }\n}\nfn cold_workloads() {\n    let measure=Width;\n    let texts:Vec<_>=(0..512).map(|index|format!(\"admission segment {index}\")).collect();\n    let profile=EngineProfile::default();\n    let options=PrepareOptions::default();\n    let text=\"alpha beta gamma \u6f22\u5b57\u306e\u6587\u7ae0 Ame\\u{301}lie \ud83d\udc69\u200d\ud83d\udcbb delta epsilon alpha beta gamma\".repeat(4);\n    for case in [\"admission_churn_10000\",\"prepare_unicode_100\"] {\n        for sample in 0..6 {\n            let mut cache=MeasureCache::with_capacity(8);\n            let mut probe=AllocProbe::new();\n            let start=Instant::now();\n            if case==\"admission_churn_10000\" {\n                for index in 0..10000 { black_box(cache.get_width(&texts[index%512],&measure)); }\n            } else {\n                for _ in 0..100 { black_box(prepare_with_segments(&text,&measure,&profile,&options)); }\n            }\n            let elapsed=start.elapsed().as_nanos();\n            let allocations=probe.sample(\"cold-text-workloads\");\n            println!(\"{{\\\"case\\\":\\\"{case}\\\",\\\"sample\\\":{sample},\\\"elapsed_ns\\\":{elapsed},\\\"allocations\\\":{},\\\"allocated_bytes\\\":{}}}\",allocations.count,allocations.bytes);\n        }\n    }\n}\nfn main() {\n    let measure=Width;\n    for count in [128usize,4096] {\n        let texts:Vec<_>=(0..count).map(|index|format!(\"cached segment {index}\")).collect();\n        let mut cache=MeasureCache::new();\n        for text in &texts { black_box(cache.get_width(text,&measure)); }\n        assert_eq!(cache.len(),count);\n        let mut index=0u64;\n        for sample in 0..6 {\n            let mut check_index=index;\n            let mut expected=0.0;\n            for _ in 0..10000 {\n                check_index=check_index.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n                expected+=texts[((check_index>>32) as usize)%count].len() as f64*8.0;\n            }\n            let mut probe=AllocProbe::new();\n            let start=Instant::now();\n            let mut sum=0.0;\n            for _ in 0..10000 {\n                index=index.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n                sum+=cache.get_width(black_box(&texts[((index>>32) as usize)%count]),&measure);\n            }\n            black_box(sum);\n            let elapsed=start.elapsed().as_nanos();\n            let allocations=probe.sample(\"populated-cache-hits\");\n            assert_eq!(sum,expected);\n            println!(\"{{\\\"entries\\\":{count},\\\"sample\\\":{sample},\\\"elapsed_ns\\\":{elapsed},\\\"allocations\\\":{},\\\"allocated_bytes\\\":{}}}\",allocations.count,allocations.bytes);\n        }\n    }\n    cold_workloads();\n}\n",
